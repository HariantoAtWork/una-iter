services:
  literoute:
    image: harianto/literoute:latest
    container_name: literoute
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - ./data/literoute:/var/lib/literoute
    env_file:
      - .env
    environment:
      - TZ=${TZ:-UTC}
      - NITRO_HOST=0.0.0.0
      - NITRO_PORT=3000
      - NUXT_ADMINISTRATOR_USERNAME=${ADMINISTRATOR_USERNAME:-}
      - NUXT_ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      - NUXT_DATA_ROOT=${NUXT_DATA_ROOT:-/var/lib/literoute}
      - NUXT_APP_SECRET=${NUXT_APP_SECRET:-}
