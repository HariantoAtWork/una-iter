networks:
  tsdproxy:
    external: true

services:
  unaiter:
    ports: !reset
    networks:
      - tsdproxy
    labels:
      tsdproxy.enable: true
      tsdproxy.name: unaiter
      tsdproxy.autodetect: true
      tsdproxy.port.1: "443/https:3000/http"
      tsdproxy.port.2: "80/http:3000/http"
    extra_hosts:
      - "host.docker.internal:host-gateway"
